rules_version = '2';

// iKrypt does not use Cloud Storage. The legacy `encrypted-files/` upload
// feature was removed; its old rules allowed public reads and unauthenticated
// writes. Deny everything. Deploying these rules (firebase deploy --only
// storage) closes any bucket left open by an earlier deployment.
// See docs/FIREBASE-AND-INFRA-VERIFICATION.md, section 3.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

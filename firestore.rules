rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All Firestore reads/writes for iKrypt must go through server-side API
    // routes using the Firebase Admin SDK. The Admin SDK authenticates with
    // server credentials and bypasses Firestore Security Rules.
    //
    // Direct browser/client access is denied for every collection so users
    // cannot bypass API-level rate limits, expiry checks, or one-time-view
    // transaction logic.
    //
    // Legacy collections such as encrypted-pastes, one-time-messages, and
    // chat-rooms should remain denied unless a live feature explicitly needs
    // them and has a separate reviewed security model.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

{
  "name": "ikrypt",
  "version": "2.0.0",
  "description": "Send secrets safely. Once. Zero-knowledge encryption with keys that never touch our servers.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "tsx scripts/submit-indexnow.ts || true",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:concurrency": "firebase emulators:exec --config firebase.test.json --only firestore --project demo-ikrypt \"tsx scripts/test-concurrent-view.ts\"",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e next build && NEXT_DIST_DIR=.next-e2e firebase emulators:exec --config firebase.test.json --only firestore --project demo-ikrypt \"playwright test\"",
    "typecheck": "tsc --noEmit",
    "dev:local": "firebase emulators:exec --only firestore --project demo-ikrypt \"next dev\"",
    "email:test": "tsx --env-file=.env.local scripts/send-test-email.ts"
  },
  "dependencies": {
    "@upstash/ratelimit": "^2.2.1",
    "@upstash/redis": "^1.41.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "firebase-admin": "^14.5.1",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "tailwindcss": "^3.4.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.3",
    "@playwright/test": "^1.65.1",
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "eslint-config-prettier": "^10.1.8",
    "firebase-tools": "^15.22.4",
    "postcss": "^8.5.33",
    "prettier": "^3.7.4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    }
  }
}
